{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // `test-support.ts` is test-only plumbing that carries no `.test.ts` suffix,
  // so it needs naming here to stay out of dist/ alongside the tests it serves.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support.ts"]
}
